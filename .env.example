# ── Auth0 Configuration ────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# See the notebook's Auth0 Setup Reference section for setup instructions.

# Your Auth0 tenant domain (without https://)
AUTH0_DOMAIN=your-tenant.us.auth0.com

# API Audience/Identifier (created in Auth0 Dashboard > Applications > APIs)
AUTH0_AUDIENCE=https://agentcore-demo-api

# Gateway App (Gateway -> MCP Server) - Machine-to-Machine Application
AUTH0_GATEWAY_CLIENT_ID=your-gateway-client-id
AUTH0_GATEWAY_CLIENT_SECRET=your-gateway-client-secret
AUTH0_MCP_SCOPE=mcp:invoke

# Agent App (Agent -> Gateway) - Machine-to-Machine Application
AUTH0_AGENT_CLIENT_ID=your-agent-client-id
AUTH0_AGENT_CLIENT_SECRET=your-agent-client-secret
AUTH0_AGENT_SCOPE=gateway:invoke

# User App (User -> Agent) - Regular Web Application with Authorization Code grant
# Add http://localhost:8080/callback as Allowed Callback URL in Auth0
AUTH0_USER_CLIENT_ID=your-user-client-id
AUTH0_USER_CLIENT_SECRET=your-user-client-secret
AUTH0_USER_SCOPE=agent:invoke openid email

# Demo Users (for RBAC testing - emails used as login_hint)
AUTH0_USER_ALICE_EMAIL=alice@example.com
AUTH0_USER_BOB_EMAIL=bob@example.com

# ── AWS Configuration ──────────────────────────────────────────────────────────
# AWS credentials should be set via AWS CLI or environment variables.
# For temporary credentials, fill in the values below.

AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN is not needed for IAM user credentials
AWS_REGION=us-east-1
